# Utilisé par la CLI `vercel`, pas par le code de l'application.
VERCEL_TOKEN=

# Mot de passe partagé protégeant l'accès à toute l'appli (voir
# src/server/authGate.ts). Requis pour démarrer le serveur.
APP_PASSWORD=

# Requis par le stockage de session (voir src/server/sessions.ts) : obtenu
# via `vercel env pull` une fois le Blob store lié au projet.
BLOB_READ_WRITE_TOKEN=

# Compteur partagé de connexion (Redis Upstash REST). Requis sur Vercel.
# En local, sans ces deux variables, le compteur reste en mémoire.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret aléatoire utilisé par Vercel Cron pour /api/cron/cleanup.
CRON_SECRET=
